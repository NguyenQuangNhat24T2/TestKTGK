<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvThongTinSV_226"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nguyen Quang Nhat - 2415053122226 - 24T2"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ten khoan chi:"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtTenKhoanChi_226"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhap ten khoan chi"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="So tien (VND):"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtSoTien_226"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhap so tien"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Ghi chu:"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtGhiChu_226"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhap ghi chu"
            android:inputType="textMultiLine"
            android:lines="3" />

        <Button
            android:id="@+id/btnThemKhoanChi_226"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Them khoan chi" />

        <Button
            android:id="@+id/btnXemChiTiet_226"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Xem chi tiet khoan chi" />

    </LinearLayout>
</ScrollView>