<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CHI TIET KHOAN CHI"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="20dp" />

    <TextView
        android:id="@+id/tvHienThiTen_226"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ten khoan chi: "
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvHienThiSoTien_226"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="So tien: "
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvHienThiGhiChu_226"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ghi chu: "
        android:textSize="16sp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnChinhSua_226"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chinh sua khoan chi" />

    <Button
        android:id="@+id/btnQuayLai_226"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Quay lai man hinh chinh" />

</LinearLayout>